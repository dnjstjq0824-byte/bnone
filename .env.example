# ==========================================================
# MOA v1.0 — Environment Variables Template (.env.example)
# ==========================================================

# Server Settings
PORT=8080
ENVIRONMENT=production
LOG_LEVEL=info
BASE_CURRENCY=KRW

# Database & Cache
DATABASE_URL=postgres://moa:moa_secret@localhost:5432/moa_db?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Migration Paths
MIGRATIONS_PATH=./database/migrations
FIXTURES_PATH=./database/fixtures

# Security & Cryptography (Generate a minimum 256-bit random key)
# Production refuses to boot without an explicit JWT_SECRET of 32+ chars.
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
TOKEN_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=30

# First-admin seeding (enable ONLY until the first real admin exists,
# then set ADMIN_BOOTSTRAP_ENABLED=false and remove the password)
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_PASSWORD=

# CORS Whitelist (comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://moa.bookingnetwork.com,https://admin.moa.bookingnetwork.com

# Web Frontend (Vite)
VITE_API_URL=http://localhost:8080
# Serve browser-local demo fixtures ONLY when explicitly true.
# Production builds must leave this unset/false with VITE_API_URL set.
VITE_MOCK_ENABLED=false

# Mobile App (Build-time Dart Define)
# flutter build apk --dart-define=API_BASE_URL=https://api.moa.bookingnetwork.com/api/v1

