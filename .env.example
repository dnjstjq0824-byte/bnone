# ==========================================================
# BN ONE v1.0 — Environment Variables Template (.env.example)
# ==========================================================

# Server Settings
PORT=8080
ENVIRONMENT=production
LOG_LEVEL=info
BASE_CURRENCY=KRW

# Database & Cache
DATABASE_URL=postgres://bnone:bnone_secret@localhost:5432/bnone_db?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Migration Paths
MIGRATIONS_PATH=./database/migrations
FIXTURES_PATH=./database/fixtures

# Security & Cryptography (Generate a minimum 256-bit random key)
JWT_SECRET=bnone-production-grade-256bit-secure-key-bookingnetwork
TOKEN_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=30

# CORS Whitelist (comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://bnone.bookingnetwork.com,https://admin.bnone.bookingnetwork.com

# Web Frontend (Vite)
VITE_API_URL=http://localhost:8080

# Mobile App (Build-time Dart Define)
# flutter build apk --dart-define=API_BASE_URL=https://api.bnone.bookingnetwork.com/api/v1
